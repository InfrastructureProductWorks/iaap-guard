  "supportClaim": false,
  "authorizedTargetObserved": false,
  "networkProbePerformed": false,
  "credentialsEmbedded": false,
  "authority": {
    "repositoryWriteAuthorityAdded": false,
    "infrastructureAuthorityAdded": false,
    "authorizationAuthorityAdded": false,
    "mergeAuthorityAdded": false,
    "deploymentAuthorityAdded": false
  }
}
