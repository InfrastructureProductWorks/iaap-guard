{
  "schemaVersion": "iaap-guard-customer-github/v0",
  "platform": "ghes",
  "webBaseUrl": "https://github.enterprise.example",
  "apiBaseUrl": "https://github.enterprise.example/api/v3",
  "appOwnership": "customer-controlled",
  "installationOwnership": "customer-controlled",
  "repositorySelection": "explicit",
  "requiredPermissions": {
    "metadata": "read",
    "contents": "read",
    "pull_requests": "read",
    "checks": "write"
